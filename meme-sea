local QUEST_PROMPT_PATH = "Workspace.NPCs.Quests_Npc.Cool Floppa Quest.Block.QuestPrompt"
local LAVA_PROMPT_PATH  = "Workspace.Island.FloppaIsland.Lava Floppa.ClickPart.ProximityPrompt"

local lavaOn, lavaThread, lavaGen = false, nil, 0

local function findByPath(path)
    local cur = game
    for n in path:gmatch("[^%.]+") do
        cur = cur:FindFirstChild(n)
        if not cur then return nil end
    end
    return cur
end

local function waitForPath(path, t)
    t = t or 5
    local t0 = tick()
    while tick() - t0 < t do
        local i = findByPath(path)
        if i then return i end
        task.wait(0.2)
    end
end

local function firePrompt(p)
    if not p or not p.Parent then return end
    pcall(function()
        p:InputHoldBegin()
        if p.HoldDuration and p.HoldDuration > 0 then task.wait(p.HoldDuration + 0.02) end
        p:InputHoldEnd()
    end)
end

local function findQuestSlot()
    local pg = LP:FindFirstChild("PlayerGui")
    local qg = pg and pg:FindFirstChild("QuestGui")
    local h = qg and qg:FindFirstChild("Holder")
    if not h then return nil end
    for _, s in ipairs(h:GetChildren()) do
        if s.Name:match("^QuestSlot%d+$") then
            local g = s:FindFirstChild("QuestGiver")
            if g and g:IsA("TextLabel") and g.Text == "Cool Floppa Quest" then return s end
        end
    end
end

local function getFloppaProgress()
    local pg = LP:FindFirstChild("PlayerGui")
    local qg = pg and pg:FindFirstChild("QuestGui")
    local h = qg and qg:FindFirstChild("Holder")
    local qt = h and h:FindFirstChild("QuestText")
    if qt and qt:IsA("TextLabel") then
        return tonumber((qt.Text or ""):match("(%d+)/%d+"))
    end
end

local function acceptFloppa(myGen)
    if myGen ~= lavaGen then return false end
    local p = waitForPath(QUEST_PROMPT_PATH, 5)
    if not p or not p:IsA("ProximityPrompt") then return false end

    for i = 1, 3 do
        if not lavaOn or myGen ~= lavaGen then return false end
        firePrompt(p)
        task.wait(0.6)
        if myGen ~= lavaGen then return false end
        if findQuestSlot() then return true end
        local still = findByPath(QUEST_PROMPT_PATH)
        if not still or not still.Enabled then
            task.wait(0.5)
            if findQuestSlot() then return true end
        end
        task.wait(0.3)
    end

    local block = p.Parent
    if block and block:IsA("BasePart") then
        tpTo(CFrame.new(block.Position + Vector3.new(0, 3, 0)))
        task.wait(0.5)
        for i = 1, 5 do
            if not lavaOn or myGen ~= lavaGen then return false end
            local p2 = findByPath(QUEST_PROMPT_PATH)
            if p2 and p2.Enabled then firePrompt(p2) end
            task.wait(0.6)
            if myGen ~= lavaGen then return false end
            if findQuestSlot() then return true end
        end
    end
    return false
end

local function spamLava(myGen)
    local p = waitForPath(LAVA_PROMPT_PATH, 5)
    if not p or not p:IsA("ProximityPrompt") then return end
    local cp = p.Parent
    if cp and cp:IsA("BasePart") then
        tpTo(CFrame.new(cp.Position + Vector3.new(0, 3, 0)))
        task.wait(0.4)
    end
    local hold = p.HoldDuration or 0
    local ref = p
    local fired = 0
    local lastProgress = 0
    local lastSeen = tick()

    while lavaOn and myGen == lavaGen do
        local cur = getFloppaProgress()
        if cur then
            lastProgress = cur
            lastSeen = tick()
            if cur >= 1000 then return end
        else
            local gone = tick() - lastSeen
            if lastProgress >= 999 then
                for _ = 1, 5 do
                    if not lavaOn or myGen ~= lavaGen then return end
                    local r = findByPath(LAVA_PROMPT_PATH)
                    if r and r.Enabled then
                        pcall(function()
                            r:InputHoldBegin()
                            if hold > 0 then task.wait(hold + 0.02) end
                            r:InputHoldEnd()
                        end)
                        fired += 1
                    end
                    task.wait(0.15)
                end
                local c2 = getFloppaProgress()
                if c2 and c2 >= 1000 then return end
                if not c2 then return end
            elseif gone > 3 then
                return
            end
        end
        if not ref.Parent or not ref.Enabled then
            local r = findByPath(LAVA_PROMPT_PATH)
            if r and r.Enabled then ref = r else task.wait(0.2); continue end
        end
        pcall(function()
            ref:InputHoldBegin()
            if hold > 0 then task.wait(hold + 0.02) end
            ref:InputHoldEnd()
        end)
        fired += 1
        if fired % 20 == 0 then task.wait() end
    end
end

QuestTab:CreateToggle({
    Name = "Auto Floppa Lava",
    Info = "Accept quest + spam tới 1000/1000",
    CurrentValue = false,
    Flag = "AutoFloppaLava",
    Callback = function(v)
        lavaOn = v
        if v then
            lavaGen += 1
            local myGen = lavaGen
            if lavaThread then pcall(task.cancel, lavaThread) end
            lavaThread = task.spawn(function()
                if not acceptFloppa(myGen) then
                    if myGen == lavaGen then lavaOn = false end
                    return
                end
                if myGen ~= lavaGen then return end
                task.wait(0.5)
                spamLava(myGen)
            end)
        else
            lavaGen += 1
            if lavaThread then pcall(task.cancel, lavaThread); lavaThread = nil end
        end
    end
})

