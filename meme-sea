local function bringMobsTo(targetCF, mobName)
    if not BRING_MOBS or not MonsterFolder then return end
    for _, m in ipairs(MonsterFolder:GetChildren()) do
        if (not mobName or m.Name == mobName) and isAlive(m) then
            local pp = m.PrimaryPart
            local hum = m:FindFirstChildOfClass("Humanoid")
            if pp and hum and (pp.Position - targetCF.Position).Magnitude < 500 then
                hum.WalkSpeed = 0
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
                pp.CFrame = targetCF
                pp.CanCollide = false
                pp.Transparency = 1
                pp.Size = Vector3.new(50, 50, 50)
            end
        end
    end
    pcall(function()
        local sp = sethiddenproperty or (getgenv and getgenv().sethiddenproperty)
        if sp then sp(LP, "SimulationRadius", math.huge) end
    end)
end

local function findNearestEnemy(name)
    if not MonsterFolder then return nil end
    local root = getRoot(LP.Character)
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, m in ipairs(MonsterFolder:GetChildren()) do
        if (not name or m.Name == name) and isAlive(m) and m.PrimaryPart then
            local d = (m.PrimaryPart.Position - root.Position).Magnitude
            if d < bestD then best, bestD = m, d end
        end
    end
    return best
end

local function farmMob(mobName)
    local m = findNearestEnemy(mobName)
    if not m or not m.PrimaryPart then return false end
    local root = getRoot(LP.Character)
    if not root then return false end

    local desired = m.PrimaryPart.CFrame * CFrame.new(0, FARM_DIST, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    local d = (root.Position - desired.Position).Magnitude
    if d > 3 then flyTo(desired) end

    equipFarmTool()
    click()
    if BRING_MOBS then bringMobsTo(m.PrimaryPart.CFrame, mobName) end
    return true
end

