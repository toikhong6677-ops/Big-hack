local Location = workspace:WaitForChild("Location")
local QuestLocation = Location:WaitForChild("QuestLocaion")
local EnemyLocation = Location:WaitForChild("Enemy_Location")

local LoadedQuests = {}
for npc, q in pairs(MQuestSettings) do
    if QuestLocation:FindFirstChild(npc) then
        table.insert(LoadedQuests, {
            NpcName = npc,
            Enemy = q.Target,
            Level = q.LevelNeed,
            EnemyPos = EnemyLocation[q.Target] and EnemyLocation[q.Target].CFrame,
            RaidBoss = q.Raid_Boss,
            SpecialQuest = q.Special_Quest,
        })
    end
end
table.sort(LoadedQuests, function(a, b) return a.Level > b.Level end)

local function getCurrentQuest()
    if not PlayerLevel then return nil end
    for _, q in ipairs(LoadedQuests) do
        if q.Level <= PlayerLevel.Value and not q.RaidBoss and not q.SpecialQuest then
            return q
        end
    end
end

local function checkQuest()
    if not QuestFolder then return nil end
    for _, v in ipairs(QuestFolder:GetChildren()) do
        local t = v:FindFirstChild("Target")
        if t and t.Value ~= "None" then return v end
    end
end

local function takeQuest(npcName)
    local npc = Quests_Npc:FindFirstChild(npcName)
    if not npc then return end
    local block = npc:FindFirstChild("Block")
    local prompt = block and block:FindFirstChild("QuestPrompt")
    if not prompt then return end

    local root = getRoot(LP.Character)
    if not root then return end
    local npcPos = npc:GetPivot().Position
    local dist = (npcPos - root.Position).Magnitude

    if dist < 6 then
        firePrompt(prompt)
        return
    end

    local loc = QuestLocation:FindFirstChild(npcName)
    local targetCF = loc and loc.CFrame or CFrame.new(npcPos + Vector3.new(0, 3, 0))
    flyTo(targetCF + Vector3.new(0, 3, 0), function()
        task.wait(0.15)
        local block2 = npc:FindFirstChild("Block")
        local p2 = block2 and block2:FindFirstChild("QuestPrompt")
        if p2 and p2.Enabled then firePrompt(p2) end
    end)
end

local function clearQuests(ignore)
    if not QuestFolder then return end
    for _, v in ipairs(QuestFolder:GetChildren()) do
        local qg = v:FindFirstChild("QuestGiver")
        local tg = v:FindFirstChild("Target")
        if qg and tg and qg.Value ~= ignore and tg.Value ~= "None" then
            pcall(function()
                OtherEvent.QuestEvents.Quest:FireServer("Abandon_Quest", { QuestSlot = v.Name })
            end)
        end
    end
end

local autoLevelOn = false
local autoNearestOn = false
local autoListOn = false
local selectedEnemies = {}
local farmThread

local function farmLoop()
    while autoLevelOn or autoNearestOn or autoListOn do
        pcall(function()
            if autoLevelOn then
                local q = getCurrentQuest()
                local cq = checkQuest()
                if q then
                    if cq then
                        local npcName = cq.QuestGiver.Value
                        local enemyName = cq.Target.Value
                        if npcName == q.NpcName then
                            if not farmMob(q.Enemy) and q.EnemyPos then
                                flyTo(q.EnemyPos + Vector3.new(0, 8, 0))
                            end
                        else
                            if not farmMob(enemyName) then
                                local loc = QuestLocation:FindFirstChild(npcName)
                                if loc then flyTo(loc.CFrame + Vector3.new(0, 5, 0)) end
                            end
                        end
                    else
                        takeQuest(q.NpcName)
                    end
                end
            elseif autoListOn and #selectedEnemies > 0 then
                for _, enemy in ipairs(selectedEnemies) do
                    if not autoListOn then break end
                    if not farmMob(enemy) then
                        local loc = EnemyLocation:FindFirstChild(enemy)
                        if loc then flyTo(loc.CFrame + Vector3.new(0, 8, 0)) end
                    end
                    task.wait()
                end
            elseif autoNearestOn then
                if not farmMob(nil) then task.wait(0.2) end
            end
        end)
        task.wait()
    end
    farmThread = nil
end

local function startFarm()
    if farmThread then return end
    farmThread = task.spawn(farmLoop)
end

