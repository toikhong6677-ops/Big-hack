local function isAlive(c)
    local h = c and c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function getRoot(c)
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- ===== FLY ENGINE =====
local flyTarget = nil
local flyOnArrive = nil
local flying = false

local function flyTo(cf, onArrive, force)
    if flying and not force then return end
    flying = true
    flyTarget = cf
    flyOnArrive = onArrive
end

RunService.RenderStepped:Connect(function(dt)
    if not flyTarget then return end
    local char = LP.Character
    local root = getRoot(char)
    if not root or not isAlive(char) then
        flyTarget = nil; flyOnArrive = nil; flying = false
        return
    end
    local dist = (root.Position - flyTarget.Position).Magnitude
    if dist <= 2 then
        root.CFrame = flyTarget
        root.AssemblyLinearVelocity = Vector3.zero
        flyTarget = nil
        flying = false
        local cb = flyOnArrive
        flyOnArrive = nil
        if cb then task.spawn(cb) end
        return
    end
    local alpha = math.min(1, (FLY_SPEED * dt) / dist)
    root.CFrame = root.CFrame:Lerp(flyTarget, alpha)
    root.AssemblyLinearVelocity = Vector3.zero
end)

local function tpTo(cf)
    local char = LP.Character
    local root = getRoot(char)
    if not root or not isAlive(char) then return end
    flyTarget = nil; flyOnArrive = nil; flying = false
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
end

-- tìm tool theo từ khoá trong ToolTip hoặc Name
local function equipFarmTool()
    local char = LP.Character
    local bp = LP:FindFirstChild("Backpack")
    if not isAlive(char) then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- nếu đang cầm tool khớp rồi thì bỏ qua
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            local tip = t.ToolTip or ""
            local nm = t.Name or ""
            if tip:find(TOOL_FARM) or nm:find(TOOL_FARM) then
                return
            end
        end
    end

    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local tip = t.ToolTip or ""
                local nm = t.Name or ""
                if tip:find(TOOL_FARM) or nm:find(TOOL_FARM) then
                    hum:EquipTool(t)
                    return
                end
            end
        end
    end
end

