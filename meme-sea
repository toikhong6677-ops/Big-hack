            local SP = PlayerData and PlayerData:FindFirstChild("SkillPoint")
            for statName in pairs(selectedStats) do
                if not autoStatsOn then break end
                local target = StatsMap[statName]
                if target and SP and SP.Value > 0 then
                    local lvl = PlayerData:FindFirstChild(target)
                    if lvl then
                        local maxLevel = MSetting.Setting and MSetting.Setting.MaxLevel or 9999
                        if lvl.Value < maxLevel then
                            local amount = math.clamp(statsPointsPer, 1, maxLevel - lvl.Value)
                            pcall(function()
                                OtherEvent.MainEvents.StatsFunction:InvokeServer({
                                    Target = target,
                                    Action = "UpgradeStats",
                                    Amount = amount
                                })
                            end)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

